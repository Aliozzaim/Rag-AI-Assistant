# cp env.example .env

# ============================================
# AWS Configuration
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
BEDROCK_MODEL_ID=anthropic.claude-v2

# ============================================
# Qdrant Vector Database Configuration
# ============================================
# Qdrant Cloud URL (or your self-hosted Qdrant URL)
QDRANT_URL=https://api.qdrant.io
# Your Qdrant API key (required for Qdrant Cloud)
QDRANT_API_KEY=QDRANT_API_KEY.123.p-bqck-3Xhm8i2ZzjQ-
# Collection name in Qdrant where your knowledge base is stored
QDRANT_COLLECTION_NAME=_knowledge_base

# ============================================
# Embedding Model Configuration
# ============================================
# OpenAI embedding model (e.g., text-embedding-ada-002)
EMBEDDING_MODEL=text-embedding-ada-002
# Your OpenAI API key for generating embeddings
OPENAI_API_KEY=your_openai_api_key

# ============================================
# API Security
# ============================================
# API key for Teams bot authentication
# Set this to a secure random string
API_KEY=test
# Header name for API key (default: X-API-Key)
API_KEY_HEADER=X-API-Key

# ============================================
# Application Configuration
# ============================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Cache TTL in seconds (default: 1 hour)
CACHE_TTL_SECONDS=3600
# Rate limit: requests per minute per IP
RATE_LIMIT_PER_MINUTE=60
# Maximum question length in characters
MAX_QUESTION_LENGTH=2000
# Maximum number of chunks to retrieve from vector DB
MAX_RETRIEVAL_CHUNKS=5

# ============================================
# Redis Configuration (Optional - for caching)
# ============================================
# Set to empty string if not using Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Stash/Bitbucket Configuration (Optional)
# ============================================
# Enable Stash/Bitbucket code search
STASH_ENABLED=false
# Stash/Bitbucket base URL
STASH_BASE_URL=https://stash.example.com
# Authentication: Username (if using username/password)
STASH_USERNAME=
# Authentication: Password (if using username/password)
STASH_PASSWORD=
# Authentication: Bearer token (alternative to username/password)
STASH_TOKEN=
# Set to true for Bitbucket Cloud, false for Bitbucket Server/Stash
STASH_IS_BITBUCKET_CLOUD=false
# Workspace name (required for Bitbucket Cloud only)
STASH_WORKSPACE=
# Maximum results per Stash search
STASH_MAX_RESULTS=10
# Request timeout in seconds
STASH_TIMEOUT=10

# ============================================
# Confluence Configuration (Optional)
# ============================================
# Enable Confluence documentation search
CONFLUENCE_ENABLED=false
# Confluence base URL
CONFLUENCE_BASE_URL=https://confluence.example.com
# Authentication: Username (if using username/password)
CONFLUENCE_USERNAME=
# Authentication: Password (if using username/password)
CONFLUENCE_PASSWORD=
# Authentication: Bearer token (alternative to username/password)
CONFLUENCE_TOKEN=
# Comma-separated list of space keys to search (leave empty for all spaces)
CONFLUENCE_SPACE_KEYS=
# Maximum results per Confluence search
CONFLUENCE_MAX_RESULTS=10
# Request timeout in seconds
CONFLUENCE_TIMEOUT=10
