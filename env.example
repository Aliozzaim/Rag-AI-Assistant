# ============================================
#  AI Assistant - Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# cp env.example .env

# ============================================
# AWS Configuration
# ============================================
AWS_REGION=eu-west-1
# Option 1: Use AWS Profile (recommended for SSO/assume role, e.g., "power-user-access")
AWS_PROFILE=power-user-access
# Option 2: Use AWS Access Key ID and Secret (if no profile)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# Format: arn:aws:bedrock:REGION:ACCOUNT_ID:inference-profile/PROFILE_ID
# Example for Meta Llama: arn:aws:bedrock:eu-west-1:442080794900:inference-profile/eu.meta.llama3-2-3b-instruct-v1:0
BEDROCK_INFERENCE_PROFILE_ARN=arn:aws:bedrock:eu-west-1:YOUR_ACCOUNT:inference-profile/eu.meta.llama3-2-3b-instruct-v1:0

# ============================================
# Qdrant Vector Database Configuration
# ============================================
# Qdrant Cloud URL (or your self-hosted Qdrant URL)
QDRANT_URL=https://api.qdrant.io
# Your Qdrant API key (required for Qdrant Cloud)
QDRANT_API_KEY=123.eyJhY2Nlc3MiOiJtIn0.p-bqck-3Xhm8i2ZzjQ-2uCQUmjL1jKKpiQtxo5qIBsq
# Collection name in Qdrant where your knowledge base is stored
QDRANT_COLLECTION_NAME=_knowledge_base

# ============================================
# Embedding Model Configuration
# ============================================
# Embedding provider: 'bedrock', 'local', or 'openai'
EMBEDDING_PROVIDER=bedrock
# Model name (depends on provider):
#   - Bedrock: amazon.titan-embed-text-v2:0 (recommended) or amazon.titan-embed-text-v1
#   - Local: all-MiniLM-L6-v2, all-mpnet-base-v2
#   - OpenAI: text-embedding-ada-002
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# Embedding dimension (for Titan V2: 1024, 512, or 256. Default: 1024)
# Smaller dimensions = less storage, same accuracy
EMBEDDING_DIMENSION=1024
# OpenAI API key (only needed if EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=

# ============================================
# API Security
# ============================================
# API key for Teams bot authentication
# Set this to a secure random string
API_KEY=your_teams_bot_api_key_here
# Header name for API key (default: X-API-Key)
API_KEY_HEADER=X-API-Key

# ============================================
# Application Configuration
# ============================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Cache TTL in seconds (default: 1 hour)
CACHE_TTL_SECONDS=3600
# Rate limit: requests per minute per IP
RATE_LIMIT_PER_MINUTE=60
# Maximum question length in characters
MAX_QUESTION_LENGTH=2000
# Maximum number of chunks to retrieve from vector DB
MAX_RETRIEVAL_CHUNKS=5
# Score threshold for vector similarity search (0.0-1.0)
# Lower values (0.4-0.5) = more results, less precise
# Higher values (0.7-0.9) = fewer results, more precise
# Recommended: 0.5 for better recall
SCORE_THRESHOLD=0.5
# Adjacent chunk retrieval: retrieve surrounding chunks for better context
# When enabled, if chunk #5 is found, also retrieves chunks #4 and #6 from the same document
# This provides better context and more complete answers
INCLUDE_ADJACENT_CHUNKS=true
# Number of chunks before/after to retrieve (default: 1 = ±1 chunk)
# Example: window=1 retrieves chunks [4, 5, 6] if chunk 5 is found
# Example: window=2 retrieves chunks [3, 4, 5, 6, 7] if chunk 5 is found
ADJACENT_CHUNKS_WINDOW=1

# ============================================
# MongoDB Configuration (Optional - for product_scraper_api)
# ============================================
# Enable MongoDB product database search
MONGODB_ENABLED=false
# MongoDB connection URI
# Format: mongodb+srv://username:password@cluster.mongodb.net/
# Or: mongodb://username:password@host:port/
MONGODB_URI=mongodb+srv://ali:12@productreview.ruwhdas.mongodb.net/
# Database name (default: ProductReview)
MONGODB_DATABASE_NAME=ProductReview
# Products collection name (default: products)
MONGODB_PRODUCTS_COLLECTION=products
# Reviews collection name (default: marketplace_reviews)
MONGODB_REVIEWS_COLLECTION=marketplace_reviews
# Maximum results per MongoDB search
MONGODB_MAX_RESULTS=10
# Request timeout in seconds
MONGODB_TIMEOUT=10

# ============================================
# Conversation Memory Configuration
# ============================================
# Enable conversation history/memory (requires Redis)
# When enabled, the LLM remembers previous messages in a conversation
ENABLE_CONVERSATION_MEMORY=true
# Maximum conversation history messages to include in prompt (default: 10)
# More messages = better context but longer prompts
MAX_CONVERSATION_HISTORY=10
# Conversation TTL in hours (default: 24 hours)
# After this time, conversation history expires
CONVERSATION_TTL_HOURS=24

# ============================================
# Query Rewriting Configuration
# ============================================
# Enable query rewriting to fix typos and improve search results
# Automatically fixes common typos like "teach stack" -> "tech stack"
ENABLE_QUERY_REWRITING=true
# Use LLM for advanced query rewriting (slower but better, requires Bedrock)
# When enabled, uses LLM to expand queries with synonyms and fix complex typos
ENABLE_LLM_QUERY_REWRITING=false

# ============================================
# Redis Configuration (Optional - for caching and conversation memory)
# ============================================
# Set to empty string if not using Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Stash/Bitbucket Configuration (Optional)
# ============================================
# Enable Stash/Bitbucket code search
STASH_ENABLED=false
# Stash/Bitbucket base URL
STASH_BASE_URL=https://stash.example.com
# Authentication: Username (if using username/password)
STASH_USERNAME=
# Authentication: Password (if using username/password)
STASH_PASSWORD=
# Authentication: Bearer token (alternative to username/password)
STASH_TOKEN=
# Set to true for Bitbucket Cloud, false for Bitbucket Server/Stash
STASH_IS_BITBUCKET_CLOUD=false
# Workspace name (required for Bitbucket Cloud only)
STASH_WORKSPACE=
# Maximum results per Stash search
STASH_MAX_RESULTS=10
# Request timeout in seconds
STASH_TIMEOUT=10

# ============================================
# Confluence Configuration (Optional)
# ============================================
# Enable Confluence documentation search
CONFLUENCE_ENABLED=false
# Confluence base URL
CONFLUENCE_BASE_URL=https://confluence.example.com
# Authentication: Username (if using username/password)
CONFLUENCE_USERNAME=
# Authentication: Password (if using username/password)
CONFLUENCE_PASSWORD=
# Authentication: Bearer token (alternative to username/password)
CONFLUENCE_TOKEN=
# Use /wiki/rest/api/search endpoint (CQL search) instead of /rest/api/content/search
# Set to true to use the wiki search API endpoint (GET request with CQL query)
CONFLUENCE_USE_WIKI_SEARCH=false
# Comma-separated list of space keys to search (leave empty for all spaces)
CONFLUENCE_SPACE_KEYS=
# Maximum results per Confluence search
CONFLUENCE_MAX_RESULTS=10
# Request timeout in seconds
CONFLUENCE_TIMEOUT=10
